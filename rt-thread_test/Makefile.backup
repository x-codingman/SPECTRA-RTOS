# Makefile for compiling lwp_syscall.c into a single LLVM bitcode file

DEFINES = -DRT_USING_SMART \
          -DRT_USING_LWP \
          -DRT_USING_NEWLIB \
          -DRT_USING_POSIX \
          -DRT_USING_LIBC \
          -DRT_USING_SIGNALS

# Compiler and flags
CC = clang
CFLAGS = -emit-llvm -c -g -O0 -w -Wno-everything

# Base directory
BASE_DIR = /home/klee/klee_src

# RT-Thread include paths (using -I)
INCLUDES = -I$(BASE_DIR)/test-rtos/rt-thread/include
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/compilers/common/include
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/lwp
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/bsp/stm32/libraries/templates/stm32l5xx
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/compilers/common/include
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/compilers/common/extension
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/posix/io/stdio/posix
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/posix/signal
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/posix/io/stdio
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/libc/posix/io
INCLUDES += -I$(BASE_DIR)/test-rtos/rt-thread/components/lwp/arch/arm/cortex-a
INCLUDES += -I./wrappers

# Add all component subdirectories
COMPONENTS_DIR = $(BASE_DIR)/test-rtos/rt-thread/components
INCLUDES += $(shell find $(COMPONENTS_DIR) -type d -exec echo "-I{}" \;)

# System include paths (using -isystem)
SYS_INCLUDES = -isystem /usr/include
SYS_INCLUDES += -isystem /usr/include/x86_64-linux-gnu/bits
SYS_INCLUDES += -isystem /usr/include/x86_64-linux-gnu/gnu
SYS_INCLUDES += -isystem /usr/include/x86_64-linux-gnu/sys
SYS_INCLUDES += -isystem /usr/include/x86_64-linux-gnu/asm
SYS_INCLUDES += -isystem /usr/include/x86_64-linux-gnu/linux

# Source and output directories
SRC_DIR = $(BASE_DIR)/test-rtos/rt-thread/components/lwp
OUT_DIR = bc_files

# Source file
SRC = $(SRC_DIR)/lwp_syscall.c

# Output file
OUTPUT = $(OUT_DIR)/lwp_syscall.bc

# Create output directory if it doesn't exist
$(shell mkdir -p $(OUT_DIR))

# Default target
all: .FORCE $(OUTPUT)

# Rule to compile the entire file into a .bc file
$(OUTPUT): $(SRC)
	$(CC) $(CFLAGS) $(INCLUDES) $(SYS_INCLUDES) $(DEFINES) -o $@ $<

# Clean target
clean:
	rm -rf $(OUT_DIR)

# Force rebuild
.FORCE:

.PHONY: all clean .FORCE 